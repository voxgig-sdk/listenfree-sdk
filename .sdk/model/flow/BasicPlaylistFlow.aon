# BasicPlaylistFlow

main: kit: flow: BasicPlaylistFlow:
{
  entity: "playlist",
  kind: "basic",
  name: "BasicPlaylistFlow",
  step: [
    {
      input: {
        ref: "playlist_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "playlist_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "playlist_ref01",
        srcdatavar: "playlist_ref01_data",
        suffix: "_up0",
        textfield: "createdAt"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-playlist_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "playlist_ref01",
        srcdatavar: "playlist_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "playlist01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-playlist_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "playlist_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "playlist01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "playlist_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPlaylistFlow"
}