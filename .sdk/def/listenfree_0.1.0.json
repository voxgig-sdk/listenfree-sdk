  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT authentication token"
      }
    },
    "schemas": {
      "Song": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the song"
          },
          "title": {
            "type": "string",
            "description": "Song title"
          },
          "artist": {
            "type": "string",
            "description": "Artist name"
          },
          "album": {
            "type": "string",
            "description": "Album name"
          },
          "duration": {
            "type": "integer",
            "description": "Duration in seconds"
          },
          "releaseDate": {
            "type": "string",
            "format": "date",
            "description": "Release date"
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Music genres"
          },
          "coverArt": {
            "type": "string",
            "format": "uri",
            "description": "URL to cover art image"
          },
          "hasVideo": {
            "type": "boolean",
            "description": "Whether video preview is available"
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "object",
            "properties": {
              "songs": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Song"
                }
              },
              "artists": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "image": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              },
              "albums": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "artist": {
                      "type": "string"
                    },
                    "coverArt": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              },
              "playlists": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Playlist"
                }
              }
            }
          },
          "total": {
            "type": "integer",
            "description": "Total number of results"
          },
          "offset": {
            "type": "integer",
            "description": "Current offset"
          },
          "limit": {
            "type": "integer",
            "description": "Results per page"
          }
        }
      },
      "StreamResponse": {
        "type": "object",
        "properties": {
          "streamUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL for streaming the song"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Expiration time of the stream URL"
          },
          "quality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "description": "Audio quality"
          },
          "bitrate": {
            "type": "integer",
            "description": "Audio bitrate in kbps"
          }
        }
      },
      "VideoResponse": {
        "type": "object",
        "properties": {
          "videoUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL for video preview"
          },
          "thumbnailUrl": {
            "type": "string",
            "format": "uri",
            "description": "Video thumbnail URL"
          },
          "duration": {
            "type": "integer",
            "description": "Video duration in seconds"
