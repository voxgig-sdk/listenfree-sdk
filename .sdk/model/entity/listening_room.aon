# Entity: listening_room

main: kit: entity: listening_room: {

  alias: field: {}

  fields: [
    {
      format: "date-time"
      name: "createdAt"
      req: false
      type: "`$STRING`"
    }
    {
      name: "currentSong"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "description"
      req: false
      short: "Room description"
      type: "`$STRING`"
    }
    {
      name: "host"
      req: false
      short: "User ID of room host"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the listening room"
      type: "`$STRING`"
    }
    {
      name: "isPublic"
      req: false
      short: "Whether room is public"
      type: "`$BOOLEAN`"
    }
    {
      name: "maxParticipants"
      req: false
      short: "Maximum number of participants"
      type: "`$INTEGER`"
    }
    {
      name: "name"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
